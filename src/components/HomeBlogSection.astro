---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";

const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);

const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

{
  latestPosts.length > 0 && (
    <section class="py-16 bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
      <div class="max-w-screen-2xl mx-auto px-4 md:px-8">
        <!-- Encabezado -->
        <div class="text-center mb-12">
          <h2 class="text-4xl font-extrabold text-gray-900 dark:text-gray-100 mb-4">
            Últimos artículos del{" "}
            <span class="text-purple-700 dark:text-purple-400">Blog</span>
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            Consejos, guías y reflexiones sobre desarrollo web, SEO y tecnología.
          </p>
        </div>

        <!-- Grid de cards — misma estructura que /blog -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.id}
              image={post.data.image}
              tags={post.data.tags}
            />
          ))}
        </div>

        <!-- CTA -->
        <div class="text-center mt-12">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-8 py-3 rounded-lg font-semibold
                   bg-purple-700 text-white hover:bg-purple-800
                   transition-all duration-200 shadow-md hover:shadow-lg active:scale-[0.98]"
          >
            Ver todos los artículos
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )
}
