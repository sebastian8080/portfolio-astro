---
// FeaturedServices.astro (Versión mejorada)
// Componente para mostrar servicios destacados usando configuración centralizada
import { getFeaturedServices } from "../config/services";

interface Props {
  limit?: number;
  class?: string;
}

const { limit = 3, class: className = "" } = Astro.props;

const featuredServices = getFeaturedServices(limit);
---

<div
  class={`bg-white rounded-2xl shadow-lg p-6 sticky ${className}`}
  style="top: 110px;"
>
  <h3 class="text-lg font-bold text-gray-900 mb-6">Servicios Destacados</h3>

  <div class="space-y-4">
    {
      featuredServices.map((service) => (
        <article class="group">
          <a
            href={service.url}
            class="block hover:bg-gray-50 rounded-lg p-4 transition-all duration-300 border border-gray-100 hover:border-purple-200"
          >
            {/* Icono y título */}
            <div class="flex items-start gap-3 mb-2">
              <div
                class={`flex-shrink-0 w-10 h-10 ${service.color} rounded-lg flex items-center justify-center text-white`}
              >
                <i class={`${service.icono} text-lg`} />
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="font-semibold text-gray-900 mb-1 group-hover:text-purple-600 transition-colors line-clamp-2">
                  {service.nombre}
                </h4>
                <p class="text-sm text-gray-600 line-clamp-2">
                  {service.descripcion}
                </p>
              </div>
            </div>

            {/* Indicador de enlace */}
            <div class="flex items-center justify-end mt-2">
              <span class="text-xs text-purple-600 font-medium group-hover:underline flex items-center gap-1">
                Ver más
                <svg
                  class="w-3 h-3 transition-transform group-hover:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </span>
            </div>
          </a>
        </article>
      ))
    }
  </div>

  {/* Botón Ver todos los servicios */}
  <div class="mt-6 pt-6 border-t border-gray-200">
    <a
      href="/servicios"
      class="block w-full text-center bg-gradient-to-r from-purple-600 to-indigo-600 text-white px-4 py-3 rounded-lg font-semibold hover:from-purple-700 hover:to-indigo-700 transition-all duration-300 shadow-md hover:shadow-lg"
    >
      Ver todos los servicios
    </a>
  </div>
</div>
