---
const navLinks = [
  { name: "Inicio", href: "/" },
  { name: "Servicios", href: "/servicios" },
  { name: "Sobre Mí", href: "/sobre-mi" },
  { name: "Blog", href: "/blog" },
  { name: "Contacto", href: "/contacto" },
];

const logoPath = "/assets/logo-sa-tech-transparente.webp";
---

<header
  class="bg-white dark:bg-gray-900 shadow-sm dark:shadow-gray-950 border-b border-gray-100 dark:border-gray-800 sticky top-0 z-40 transition-colors duration-300"
>
  <nav class="container mx-auto px-4 py-3 flex justify-between items-center">
    <a class="leading-none shrink-0" href="/">
      <img width="180" src={logoPath} alt="Logo de SA TECH" />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex lg:items-center lg:gap-6 xl:gap-8">
      {
        navLinks.map((link) => (
          <li>
            <a
              class="text-base font-medium text-gray-600 dark:text-gray-300 hover:text-purple-700 dark:hover:text-purple-400 transition-colors duration-200"
              href={link.href}
            >
              {link.name}
            </a>
          </li>
        ))
      }

      <!-- Theme toggle — desktop -->
      <li>
        <button
          class="theme-toggle group relative inline-flex h-7 w-14 shrink-0 cursor-pointer items-center rounded-full
                 bg-slate-200 dark:bg-violet-600
                 transition-colors duration-300 ease-in-out
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500
                 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900"
          aria-label="Cambiar tema claro/oscuro"
          type="button"
        >
          <!-- Dot deslizante -->
          <span
            class="pointer-events-none inline-flex h-5 w-5 items-center justify-center rounded-full
                   bg-white shadow-md ring-0
                   translate-x-1 dark:translate-x-[1.75rem]
                   transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
          >
            <!-- Sol (visible en modo claro) -->
            <svg
              class="block dark:hidden h-3 w-3 text-amber-500"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.172 18.894a.75.75 0 0 0 1.06 1.06l1.591-1.59a.75.75 0 1 0-1.061-1.061l-1.59 1.591ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.166 5.106a.75.75 0 0 0-1.06 1.06l1.59 1.591a.75.75 0 1 0 1.061-1.06l-1.591-1.59Z"
              ></path>
            </svg>
            <!-- Luna (visible en modo oscuro) -->
            <svg
              class="hidden dark:block h-3 w-3 text-violet-600"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
        </button>
      </li>

      <li>
        <a
          href="/contacto"
          class="ml-2 inline-block px-5 py-2 bg-purple-700 text-white text-sm font-semibold rounded-lg
                 hover:bg-purple-800 active:scale-95 transition-all duration-200 shadow-sm"
        >
          ¡Empecemos!
        </a>
      </li>
    </ul>

    <!-- Mobile: toggle + burger -->
    <div class="flex items-center gap-2 lg:hidden">
      <!-- Theme toggle — mobile (siempre visible, al lado del burger) -->
      <button
        class="theme-toggle relative inline-flex h-6 w-12 shrink-0 cursor-pointer items-center rounded-full
               bg-slate-200 dark:bg-violet-600
               transition-colors duration-300 ease-in-out
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500
               focus-visible:ring-offset-1 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900"
        aria-label="Cambiar tema claro/oscuro"
        type="button"
      >
        <span
          class="pointer-events-none inline-flex h-4 w-4 items-center justify-center rounded-full
                 bg-white shadow-md ring-0
                 translate-x-1 dark:translate-x-[1.5rem]
                 transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
        >
          <svg
            class="block dark:hidden h-2.5 w-2.5 text-amber-500"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.172 18.894a.75.75 0 0 0 1.06 1.06l1.591-1.59a.75.75 0 1 0-1.061-1.061l-1.59 1.591ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.166 5.106a.75.75 0 0 0-1.06 1.06l1.59 1.591a.75.75 0 1 0 1.061-1.06l-1.591-1.59Z"
            ></path>
          </svg>
          <svg
            class="hidden dark:block h-2.5 w-2.5 text-violet-600"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z"
              clip-rule="evenodd"></path>
          </svg>
        </span>
      </button>

      <!-- Burger -->
      <button
        id="navbar-burger"
        type="button"
        class="flex items-center justify-center p-2 rounded-lg text-gray-600 dark:text-gray-300
               hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-200
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
        aria-label="Abrir menú"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile slide-in menu -->
<div
  id="navbar-menu"
  class="fixed inset-y-0 right-0 w-72 bg-white dark:bg-gray-900 border-l border-gray-100 dark:border-gray-800
         shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-50 lg:hidden"
  aria-modal="true"
  role="dialog"
>
  <div class="flex flex-col h-full">
    <!-- Header del menú -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 dark:border-gray-800">
      <a href="/" class="leading-none">
        <img width="120" src={logoPath} alt="Logo de SA TECH" />
      </a>
      <button
        id="navbar-close"
        type="button"
        class="flex items-center justify-center p-2 rounded-lg text-gray-500 dark:text-gray-400
               hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-200
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
        aria-label="Cerrar menú"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Links -->
    <nav class="flex-1 overflow-y-auto px-4 py-6">
      <ul class="space-y-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                class="flex items-center px-4 py-3 text-base font-medium rounded-lg
                       text-gray-700 dark:text-gray-300
                       hover:bg-purple-50 dark:hover:bg-gray-800
                       hover:text-purple-700 dark:hover:text-purple-400
                       transition-colors duration-200"
                href={link.href}
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Footer del menú -->
    <div class="px-5 py-5 border-t border-gray-100 dark:border-gray-800 space-y-3">
      <a
        href="/contacto"
        class="block w-full text-center px-4 py-3 bg-purple-700 text-white rounded-lg
               font-semibold hover:bg-purple-800 active:scale-[0.98] transition-all duration-200"
      >
        ¡Empecemos!
      </a>
      <p class="text-xs text-center text-gray-400 dark:text-gray-600">
        © {new Date().getFullYear()} SA TECH
      </p>
    </div>
  </div>
</div>

<!-- Backdrop -->
<div
  id="navbar-backdrop"
  class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 hidden lg:hidden transition-opacity duration-300"
></div>

<script is:inline>
  // ── Theme toggle ─────────────────────────────────────────────────────────
  // El estado visual del toggle (posición del dot, colores del track, iconos)
  // es 100% CSS mediante las clases dark: de Tailwind.
  // JavaScript solo gestiona la clase `dark` en <html> y el localStorage.

  function setTheme(dark) {
    var html = document.documentElement;
    if (dark) {
      html.classList.add("dark");
      localStorage.setItem("theme", "dark");
    } else {
      html.classList.remove("dark");
      localStorage.setItem("theme", "light");
    }
  }

  function initThemeToggles() {
    document.querySelectorAll(".theme-toggle").forEach(function (btn) {
      // Elimina listeners previos clonando el nodo
      var clone = btn.cloneNode(true);
      btn.parentNode.replaceChild(clone, btn);

      clone.addEventListener("click", function () {
        var isDark = document.documentElement.classList.contains("dark");
        setTheme(!isDark);
      });
    });
  }

  // ── Mobile menu ───────────────────────────────────────────────────────────
  function initMobileMenu() {
    var burger = document.getElementById("navbar-burger");
    var close = document.getElementById("navbar-close");
    var menu = document.getElementById("navbar-menu");
    var backdrop = document.getElementById("navbar-backdrop");

    if (!burger || !close || !menu || !backdrop) return;

    function openMenu() {
      menu.classList.remove("translate-x-full");
      menu.classList.add("translate-x-0");
      backdrop.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      burger.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
      menu.classList.add("translate-x-full");
      menu.classList.remove("translate-x-0");
      backdrop.classList.add("hidden");
      document.body.style.overflow = "";
      burger.setAttribute("aria-expanded", "false");
    }

    // Clona para eliminar listeners duplicados en navegaciones con ViewTransitions
    [burger, close, backdrop].forEach(function (el) {
      var c = el.cloneNode(true);
      el.parentNode.replaceChild(c, el);
    });

    document.getElementById("navbar-burger").addEventListener("click", openMenu);
    document.getElementById("navbar-close").addEventListener("click", closeMenu);
    document.getElementById("navbar-backdrop").addEventListener("click", closeMenu);

    window.addEventListener("resize", function () {
      if (window.innerWidth >= 1024) closeMenu();
    });

    // Cierra el menú al navegar
    document.getElementById("navbar-menu").querySelectorAll("a").forEach(function (a) {
      a.addEventListener("click", closeMenu);
    });
  }

  function init() {
    initThemeToggles();
    initMobileMenu();
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:after-swap", init);
</script>
