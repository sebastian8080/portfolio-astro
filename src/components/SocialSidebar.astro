---
import { socialLinks } from "../config/social";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<aside class={`${className} h-full`}>
  <div class="sticky max-h-[calc(100vh-4rem)] overflow-auto" style="top: 110px;">
    <div class="bg-white dark:bg-gray-800 border border-transparent dark:border-gray-700 rounded-2xl shadow-lg dark:shadow-gray-900/50 p-6 transition-colors duration-300">
      <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4 text-center">
        Sígueme
      </h3>

      <div class="flex flex-col gap-3">
        {
          socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`flex items-center justify-center gap-3 p-3 rounded-lg
                      bg-gray-100 dark:bg-gray-700
                      transition-all duration-300 ${social.color} hover:text-white group`}
              aria-label={social.ariaLabel}
            >
              <i class={`${social.icon} text-xl`} />
              <span class="font-medium text-sm">{social.name}</span>
            </a>
          ))
        }
      </div>

      <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
        <p class="text-sm text-gray-600 dark:text-gray-400 text-center">
          ¡Conectemos y compartamos conocimiento!
        </p>
      </div>
    </div>
  </div>
</aside>

<style>
  aside {
    position: relative;
  }
</style>
