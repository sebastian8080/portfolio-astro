---
// SocialSidebar.astro (Versión mejorada)
// Componente sticky para mostrar redes sociales usando configuración centralizada
import { socialLinks } from "../config/social";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<aside class={`${className} h-full`}>
  <div
    class="sticky max-h-[calc(100vh-4rem)] overflow-auto"
    style="top: 110px;"
  >
    <div class="bg-white rounded-2xl shadow-lg p-6">
      <h3 class="text-lg font-bold text-gray-900 mb-4 text-center">Sígueme</h3>

      <div class="flex flex-col gap-3">
        {
          socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`flex items-center justify-center gap-3 p-3 rounded-lg bg-gray-100 transition-all duration-300 ${social.color} hover:text-white group`}
              aria-label={social.ariaLabel}
            >
              <i class={`${social.icon} text-xl`} />
              <span class="font-medium text-sm">{social.name}</span>
            </a>
          ))
        }
      </div>

      <!-- Decoración opcional -->
      <div class="mt-6 pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-600 text-center">
          ¡Conectemos y compartamos conocimiento!
        </p>
      </div>
    </div>
  </div>
</aside>

<style>
  /* Asegurar que el scroll interno sea suave */
  aside {
    position: relative;
  }
</style>
