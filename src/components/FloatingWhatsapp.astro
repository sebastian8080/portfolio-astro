---
interface Props {
  phoneNumber: string;
  defaultMessage?: string;
}

// Desestructuración de Astro.props con valor por defecto para defaultMessage
const {
  phoneNumber,
  defaultMessage = "¡Hola Sebas! Quisiera hacer una consulta.",
} = Astro.props;

// Codificación del mensaje para la URL
const encodedMessage = encodeURIComponent(defaultMessage);

// Construcción del enlace de WhatsApp
const whatsappLink = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;
---

<a
  href={whatsappLink}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50
		p-3 md:p-4
		bg-green-500 hover:bg-green-600
		text-white
		rounded-full shadow-lg transition-all duration-300
		flex items-center space-x-2
		cursor-pointer
		group"
  aria-label="Chatear con nosotros por WhatsApp"
>
  <img
    src="/assets/whatsapp-icon.svg"
    alt="Icono de WhatsApp"
    class="w-[30px] max-w-sm"
  />

  <span
    class="hidden md:block
			text-sm font-semibold whitespace-nowrap
			group-hover:mr-1 transition-all duration-300"
  >
    Haz una consulta
  </span>
</a>
