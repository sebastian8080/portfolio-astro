---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  image?: {
    url: string;
    alt: string;
  };
  tags?: string[];
}

const { title, description, pubDate, slug, image, tags = [] } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(pubDate);
---

<article
  data-animate-item
  class="group bg-white dark:bg-gray-800
         border border-gray-100 dark:border-gray-700
         rounded-xl overflow-hidden shadow-md dark:shadow-gray-900/40
         hover:shadow-2xl dark:hover:shadow-gray-900/70
         transition-all duration-300 hover:-translate-y-2 h-full flex flex-col"
>
  <a href={`/blog/${slug}`} class="flex flex-col h-full">
    {
      image ? (
        <div class="relative w-full h-48 md:h-56 overflow-hidden bg-gradient-to-br from-purple-600 to-indigo-600">
          <img
            src={image.url}
            alt={image.alt}
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      ) : (
        <div class="relative w-full h-48 md:h-56 bg-gradient-to-br from-purple-600 to-indigo-600 flex items-center justify-center">
          <svg
            class="w-16 h-16 text-white opacity-50"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
        </div>
      )
    }

    <div class="p-6 flex flex-col flex-1">
      <time
        datetime={pubDate.toISOString()}
        class="text-sm text-gray-500 dark:text-gray-400 mb-3 block"
      >
        {formattedDate}
      </time>

      <h3
        class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-3 line-clamp-2
               group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors"
      >
        {title}
      </h3>

      <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4 line-clamp-3 flex-1">
        {description}
      </p>

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4">
            {tags.map((tag) => (
              <span
                class="bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300
                       px-3 py-1 rounded-full text-sm font-medium
                       hover:bg-purple-100 dark:hover:bg-purple-900/40
                       hover:text-purple-700 dark:hover:text-purple-400
                       transition-colors"
              >
                {tag}
              </span>
            ))}
          </div>
        )
      }

      <span
        class="text-purple-600 dark:text-purple-400 font-semibold inline-flex items-center gap-2
               group-hover:gap-3 transition-all"
      >
        Leer más
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </a>
</article>
