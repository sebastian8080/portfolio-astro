---
import Layout from "../../layouts/layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
---

<Layout
  title="Servicio de Posicionamiento SEO para crecer en Google"
  description="Mejora tu visibilidad en Google con nuestro servicio de posicionamiento SEO. Atrae más tráfico orgánico y supera a tu competencia."
>
  <Breadcrumb
    items={[
      { name: "Inicio", href: "/" },
      { name: "Servicios", href: "/servicios" },
      { name: "Posicionamiento SEO" },
    ]}
  />

  <!-- HERO -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-purple-950 via-purple-800 to-purple-600 text-white"
  >
    <div
      class="container mx-auto px-4 py-20 md:py-28 grid md:grid-cols-2 gap-10 items-center"
    >
      <div class="space-y-6">
        <span
          class="inline-block text-sm font-semibold tracking-widest uppercase text-purple-200 border border-purple-400 px-4 py-1 rounded-full"
        >
          Posicionamiento Orgánico
        </span>
        <h1 class="text-4xl md:text-5xl font-bold leading-tight">
          Servicio de <span class="text-yellow-300">Posicionamiento SEO</span> efectivo
        </h1>
        <p class="text-lg text-purple-100 leading-relaxed">
          El <strong>posicionamiento SEO</strong> es la estrategia digital más rentable
          a largo plazo: te ayudamos a que te encuentren <strong
            class="text-white">antes que a la competencia</strong
          >. Si buscas <strong class="text-white">servicios SEO</strong> de un experto,
          estás en el lugar indicado.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="/contacto"
            class="inline-block py-3 px-8 bg-yellow-400 hover:bg-yellow-300 text-purple-900 font-bold rounded-full transition-colors duration-300"
          >
            ¡Mejora tu visibilidad hoy!
          </a>
          <a
            href="#servicios"
            class="inline-block py-3 px-8 border border-white text-white hover:bg-white hover:text-purple-800 font-semibold rounded-full transition-colors duration-300"
          >
            Ver servicios SEO
          </a>
        </div>
      </div>
      <div class="relative">
        <img
          src="/assets/optimizacion-motores-busqueda-seo.webp"
          alt="Imagen de Optimizacion SEO"
          class="w-full h-[300px] md:h-[420px] object-cover rounded-2xl shadow-2xl"
          title="Imagen de Optimizacion SEO"
          loading="lazy"
        />
        <div
          class="absolute -bottom-4 -left-4 bg-yellow-400 text-purple-900 font-bold text-sm px-5 py-3 rounded-xl shadow-lg"
        >
          <i class="fa-solid fa-ranking-star mr-2"></i> Posición #1 en Google
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none">
      <svg
        viewBox="0 0 1440 60"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-12 fill-white dark:fill-gray-900"
      >
        <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z"></path>
      </svg>
    </div>
  </section>

  <main class="container mx-auto px-4 py-16 space-y-24">
    <!-- STATS STRIP -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      {
        [
          { num: "+200%", label: "Tráfico orgánico" },
          { num: "1ra", label: "Página de Google" },
          { num: "100%", label: "Resultados medibles" },
          { num: "∞", label: "ROI a largo plazo" },
        ].map((stat) => (
          <div class="bg-gray-100 dark:bg-gray-800 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <p class="text-4xl font-extrabold text-purple-700">{stat.num}</p>
            <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">
              {stat.label}
            </p>
          </div>
        ))
      }
    </section>

    <!-- SERVICIOS CLAVE -->
    <section id="servicios">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold" style="color: #6a1a7b;">
          Servicios Clave de Optimización SEO
        </h2>
        <p class="text-gray-500 dark:text-gray-400 mt-3 max-w-xl mx-auto">
          Una estrategia SEO integral que cubre todos los frentes, respaldada
          por un <strong>asesoramiento SEO</strong> personalizado, para maximizar
          tu visibilidad online.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {
          [
            {
              icon: "fa-magnifying-glass",
              title: "SEO On-Page",
              desc: "Optimización de elementos internos como títulos, meta descripciones, etiquetas de encabezado y contenido para mejorar la relevancia y la indexación.",
            },
            {
              icon: "fa-link",
              title: "Link Building",
              desc: "Desarrollo de una estrategia para conseguir enlaces de calidad de otros sitios web, aumentando la autoridad y credibilidad de tu dominio.",
            },
            {
              icon: "fa-sitemap",
              title: "SEO Técnico",
              desc: "Auditoría y corrección de problemas técnicos como la velocidad, la estructura de datos, el archivo robots.txt y los mapas del sitio.",
            },
            {
              icon: "fa-chart-line",
              title: "Análisis de Competencia",
              desc: "Estudio de las estrategias SEO de tus competidores para encontrar oportunidades y desarrollar un plan que te diferencie.",
            },
          ].map((service) => (
            <div class="relative group border border-purple-100 dark:border-purple-900 bg-white dark:bg-gray-800 rounded-2xl p-8 shadow hover:shadow-xl transition-all duration-300">
              <div class="w-14 h-14 bg-purple-100 dark:bg-purple-900 rounded-xl flex items-center justify-center mb-5">
                <i
                  class={`fa-solid ${service.icon} text-2xl text-purple-600`}
                />
              </div>
              <h3 class="text-xl font-bold text-purple-700 mb-2">
                {service.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-400">{service.desc}</p>
              <div class="absolute bottom-0 left-0 h-1 w-0 group-hover:w-full bg-gradient-to-r from-purple-600 to-yellow-400 rounded-b-2xl transition-all duration-500" />
            </div>
          ))
        }
      </div>
    </section>

    <!-- QUÉ CONSEGUIRÁS -->
    <section class="bg-gray-50 dark:bg-gray-800 rounded-3xl p-10 md:p-14">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold" style="color: #6a1a7b;">
          ¿Qué conseguirás?
        </h2>
        <p class="text-gray-500 dark:text-gray-400 mt-3 max-w-xl mx-auto">
          Resultados reales y sostenibles que transforman tu presencia digital
          en un canal de ventas continuo gracias a nuestros <strong
            >servicios de posicionamiento web</strong
          >.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {
          [
            {
              text: "Un <strong>aumento significativo en el tráfico orgánico</strong> y de calidad hacia tu sitio web.",
            },
            {
              text: "Mejora en tu <strong>posicionamiento en los resultados de búsqueda</strong> para palabras clave relevantes.",
            },
            {
              text: "Una <strong>mayor autoridad y credibilidad</strong> de tu marca en el mercado online.",
            },
            {
              text: "Mayor <strong>rentabilidad y retorno de la inversión</strong> a largo plazo, sin depender de la publicidad de pago.",
            },
          ].map((item) => (
            <div class="flex items-start gap-4 bg-white dark:bg-gray-700 rounded-xl p-5 shadow-sm">
              <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                <i class="fa-solid fa-check text-purple-600 text-sm" />
              </div>
              <p
                class="text-gray-700 dark:text-gray-300"
                set:html={item.text}
              />
            </div>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section
      class="relative overflow-hidden bg-gradient-to-r from-purple-700 to-purple-900 rounded-3xl p-10 md:p-16 text-center text-white shadow-2xl"
    >
      <div
        class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_top_right,_#facc15,_transparent_60%)]"
      >
      </div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 relative z-10">
        ¿Listo para dominar los <span class="text-yellow-300"
          >resultados de búsqueda</span
        >?
      </h2>
      <p class="text-purple-200 text-lg mb-8 max-w-xl mx-auto relative z-10">
        Con nuestro <strong>servicio de posicionamiento SEO</strong>, posiciona
        tu negocio en la primera página de Google y atrae clientes potenciales
        de forma continua y sin pagar por cada clic.
      </p>
      <a
        href="/contacto"
        class="relative z-10 inline-block py-4 px-10 bg-yellow-400 hover:bg-yellow-300 text-purple-900 font-bold rounded-full text-lg transition-colors duration-300 shadow-lg"
      >
        ¡Mejora tu visibilidad hoy!
      </a>
    </section>
  </main>
</Layout>
