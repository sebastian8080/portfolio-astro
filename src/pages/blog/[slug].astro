---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/layout.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import SocialSidebar from "../../components/SocialSidebar.astro";
import LatestPosts from "../../components/LatestPosts.astro";
import FeaturedServices from "../../components/FeaturedServices.astro";

export const getStaticPaths = (async () => {
  const blogEntries = await getCollection("blog", ({ data }) => {
    return data.draft !== true;
  });

  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = new Intl.DateTimeFormat("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(entry.data.pubDate);

// URLs para compartir
const shareUrl = Astro.url.href;
const shareTitle = entry.data.title;
const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(shareUrl)}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
---

<Layout
  title={`${entry.data.title}`}
  description={entry.data.description}
  image={entry.data.image?.url}
  type="article"
  author={entry.data.author}
  pubDate={entry.data.pubDate}
>
  <article
    class="pb-12 bg-gray-50 dark:bg-gray-950 transition-colors duration-300"
  >
    <!-- Hero con imagen destacada -->
    {
      entry.data.image && (
        <div class="relative w-full h-64 md:h-96 lg:h-[500px] mb-12 overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10" />
          <img
            src={entry.data.image.url}
            alt={entry.data.image.alt}
            class="w-full h-full object-cover"
          />
          <div class="absolute bottom-0 left-0 right-0 z-20 p-6 md:p-12">
            <div class="container mx-auto">
              <div class="flex flex-wrap gap-2 mb-4">
                {entry.data.tags.map((tag) => (
                  <span class="bg-white/20 backdrop-blur-sm text-white px-3 py-1 rounded-full text-sm font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      )
    }

    <!-- Layout de 3 columnas: Redes Sociales | Contenido | Sidebar -->
    <div class="container mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Columna Izquierda: Redes Sociales (oculta en móvil) -->
        <div class="hidden lg:block lg:col-span-2">
          <SocialSidebar />
        </div>

        <!-- Columna Central: Contenido Principal -->
        <div class="lg:col-span-7">
          <div
            class="bg-white dark:bg-gray-800 dark:shadow-gray-900/50 rounded-2xl shadow-lg p-6 md:p-12 transition-colors duration-300"
          >
            <!-- Header del artículo -->
            <header class="mb-12">
              <div
                class="flex items-center gap-4 text-gray-600 dark:text-gray-400 mb-6"
              >
                <time datetime={entry.data.pubDate.toISOString()}>
                  {formattedDate}
                </time>
                <span class="text-gray-300 dark:text-gray-600">•</span>
                <span>{entry.data.author}</span>
              </div>

              <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-6 leading-tight"
              >
                {entry.data.h1text ?? entry.data.title}
              </h1>

              <p
                class="text-xl text-gray-600 dark:text-gray-400 leading-relaxed"
              >
                {entry.data.description}
              </p>

              {
                !entry.data.image && entry.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-6">
                    {entry.data.tags.map((tag) => (
                      <span class="bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-400 px-4 py-2 rounded-full text-sm font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>
                )
              }
            </header>

            <!-- Contenido del artículo con prose -->
            <div
              class="prose prose-lg max-w-none
              dark:prose-invert
              prose-headings:font-bold prose-headings:text-gray-900 dark:prose-headings:text-gray-100
              prose-h1:text-4xl prose-h1:mt-8 prose-h1:mb-4
              prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6
              prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4
              prose-h4:text-xl prose-h4:mt-6 prose-h4:mb-3
              prose-p:text-gray-700 prose-p:leading-relaxed prose-p:mb-6 prose-p:text-base dark:prose-p:text-gray-300
              prose-a:text-purple-600 prose-a:no-underline hover:prose-a:underline prose-a:font-medium dark:prose-a:text-purple-400
              prose-strong:text-gray-900 prose-strong:font-semibold dark:prose-strong:text-gray-100
              prose-em:text-gray-700 prose-em:italic dark:prose-em:text-gray-300
              prose-code:text-purple-600 prose-code:bg-purple-50 prose-code:px-2 prose-code:py-1 prose-code:rounded prose-code:text-sm prose-code:font-mono prose-code:before:content-none prose-code:after:content-none dark:prose-code:text-purple-400 dark:prose-code:bg-gray-700
              prose-pre:bg-gray-900 prose-pre:text-gray-100 prose-pre:rounded-xl prose-pre:shadow-lg prose-pre:p-4 prose-pre:overflow-x-auto dark:prose-pre:bg-gray-950 dark:prose-pre:shadow-black/50
              prose-blockquote:border-l-4 prose-blockquote:border-purple-600 prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:text-gray-700 prose-blockquote:bg-purple-50/50 prose-blockquote:py-2 dark:prose-blockquote:text-gray-300 dark:prose-blockquote:bg-purple-900/20 dark:prose-blockquote:border-purple-500
              prose-ul:list-disc prose-ul:pl-6 prose-ul:mb-6
              prose-ol:list-decimal prose-ol:pl-6 prose-ol:mb-6
              prose-li:text-gray-700 prose-li:mb-2 prose-li:leading-relaxed dark:prose-li:text-gray-300
              prose-img:rounded-xl prose-img:shadow-lg prose-img:my-8 prose-img:w-full
              prose-hr:border-gray-300 prose-hr:my-12 dark:prose-hr:border-gray-700
              prose-table:w-full prose-table:border-collapse
              prose-th:bg-purple-50 prose-th:text-left prose-th:p-3 prose-th:font-semibold prose-th:text-gray-900 prose-th:border prose-th:border-gray-300 dark:prose-th:bg-gray-700 dark:prose-th:text-gray-100 dark:prose-th:border-gray-600
              prose-td:p-3 prose-td:border prose-td:border-gray-300 prose-td:text-gray-700 dark:prose-td:border-gray-600 dark:prose-td:text-gray-300"
            >
              <Content />
            </div>

            <!-- Compartir en redes sociales -->
            <div
              class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700"
            >
              <h3
                class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4"
              >
                Compartir artículo
              </h3>
              <div class="flex flex-wrap gap-4">
                <a
                  href={twitterUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    ></path>
                  </svg>
                  Twitter
                </a>
                <a
                  href={linkedinUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 px-4 py-2 bg-blue-700 text-white rounded-lg hover:bg-blue-800 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                    ></path>
                  </svg>
                  LinkedIn
                </a>
                <a
                  href={facebookUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                    ></path>
                  </svg>
                  Facebook
                </a>
              </div>

              <!-- Navegación al blog -->
              <div class="mt-8">
                <a
                  href="/blog"
                  class="inline-flex items-center gap-2 text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 font-semibold group"
                >
                  <svg
                    class="w-5 h-5 transition-transform group-hover:-translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 19l-7-7 7-7"></path>
                  </svg>
                  Volver al blog
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Sidebar con componentes -->
        <div class="lg:col-span-3 space-y-8">
          <!-- Últimos artículos
          <LatestPosts currentSlug={entry.id} /> -->

          <!-- Servicios destacados -->
          <FeaturedServices />

          <!-- Redes sociales en móvil -->
          <div class="lg:hidden">
            <SocialSidebar />
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Posts Relacionados (ancho completo) -->
  <div class="container mx-auto px-4 md:px-6 mt-16">
    <RelatedPosts currentSlug={entry.id} tags={entry.data.tags} />
  </div>
</Layout>
