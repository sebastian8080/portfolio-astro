---
import Layout from "../layouts/layout.astro";
import Gallery from "../components/Gallery.astro";
import FAQSection from "../components/FAQSection.astro";
import HomeBlogSection from "../components/HomeBlogSection.astro";
import WhyChooseMe from "../components/WhyChooseMe.astro";
import WorkProcess from "../components/WorkProcess.astro";
import TechStack from "../components/TechStack.astro";
import FreeAuditCTA from "../components/FreeAuditCTA.astro";

// Datos para la sección "Cómo puedo ayudarte" (para el componente Gallery)
const servicesGallery = [
  {
    src: "/assets/desarrollo-web-profesional.webp",
    alt: "Desarrollo Web Profesional",
    title: "Desarrollo Web Profesional",
    href: "/servicios/desarrollo-web-profesional",
  },
  {
    src: "/assets/auditoria-tecnica.webp",
    alt: "Auditoría Técnica",
    title: "Auditoría Técnica",
    href: "/servicios/auditoria-tecnica",
  },
  {
    src: "/assets/optimizacion-motores-busqueda-seo.webp",
    alt: "Posicionamiento SEO",
    title: "Posicionamiento SEO",
    href: "/servicios/posicionamiento-seo",
  },
];

const videoBannerHomePath = "/assets/video/video-banner-home.mp4";

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Sebastián Armijos — Desarrollador Web en Cuenca",
  url: "https://sebasarmijos.dev",
  telephone: "+593964085651",
  description:
    "Desarrollador Web & Experto SEO en Cuenca, Ecuador. Especializado en Astro, Laravel, SEO técnico y soluciones digitales a medida para empresas y emprendedores de todo el país.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Cuenca",
    addressRegion: "Azuay",
    addressCountry: "EC",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -2.9001,
    longitude: -79.0059,
  },
  areaServed: [
    { "@type": "Country", name: "Ecuador" },
    { "@type": "City", name: "Quito" },
    { "@type": "City", name: "Guayaquil" },
    { "@type": "City", name: "Cuenca" },
    { "@type": "City", name: "Ambato" },
    { "@type": "City", name: "Loja" },
    { "@type": "City", name: "Machala" },
  ],
  priceRange: "$$",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de Desarrollo Web",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: "Desarrollo Web Profesional" },
      },
      {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: "Posicionamiento SEO" },
      },
      {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: "Auditoría Técnica Web" },
      },
    ],
  },
};
---

<Layout
  title="Desarrollador Web en Cuenca, Ecuador | Software a medida"
  description="Desarrollador Web en Cuenca | Experiencia en Desarrollo y Soluciones Web. Posicionamiento SEO. Impulsa tu negocio ahora. ¡Contáctame hoy!"
>
  <section
    class="relative h-[80vh] md:h-[90vh] flex items-center justify-center overflow-hidden bg-gray-900"
  >
    <video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="absolute top-0 left-0 w-full h-full object-cover opacity-30"
      poster="/assets/poster-home-banner.jpg"
    >
      <source src={videoBannerHomePath} type="video/mp4" />
      Tu navegador no soporta el tag de video.
    </video>

    <div
      class="relative z-10 text-center text-white p-6 bg-black bg-opacity-40 rounded-lg max-w-2xl mx-auto shadow-lg"
    >
      <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4">
        Desarrollador de Software <br />
        <span class="text-purple-400">en Cuenca</span>
      </h1>
      <p class="text-gray-300 text-sm italic">Software Development</p>
      <p class="text-lg md:text-xl mt-4 font-light leading-relaxed">
        <strong>Desarrollador web en Cuenca</strong> enfocado en crear <strong
          >experiencias digitales rápidas y modernas</strong
        > que impulsan tu negocio.
      </p>
      <div
        class="mt-8 flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-6"
      >
        <a
          href="/servicios"
          class="inline-block bg-purple-600 text-white font-semibold px-8 py-3 rounded-lg shadow-md hover:bg-purple-700 transition duration-300 transform hover:scale-105"
        >
          Servicios
        </a>
        <a
          href="/contacto"
          class="inline-block bg-white text-purple-700 font-semibold px-8 py-3 rounded-lg shadow-md hover:bg-gray-100 transition duration-300 transform hover:scale-105"
        >
          ¡Hablemos!
        </a>
      </div>
    </div>
  </section>

  <section
    class="py-16 md:py-24 bg-gray-50 dark:bg-gray-900 transition-colors duration-300"
  >
    <h2
      class="text-4xl font-extrabold text-gray-800 dark:text-gray-100 text-center mb-12"
    >
      Conoces nuestros <strong class="text-purple-700 dark:text-purple-400"
        >servicios de Desarrollo de Software</strong
      >
    </h2>
    <p class="text-center text-gray-700 dark:text-gray-300">
      Si necesitas algún tipo de <strong
        class="text-purple-700 dark:text-purple-400">software a medida</strong
      >, ¡también lo realizamos!
    </p>
    <Gallery images={servicesGallery} />
  </section>

  <WhyChooseMe />
  <WorkProcess />
  <TechStack />
  <FreeAuditCTA />

  <section
    class="py-16 md:py-20 bg-gray-900 dark:bg-gray-950 transition-colors duration-300"
  >
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">
        Desarrollo web para toda <span class="text-purple-400">Ecuador</span>,
        trabajando 100% remoto
      </h2>
      <p class="text-lg text-gray-300 max-w-3xl mx-auto mb-6">
        Trabajando desde Cuenca, Azuay, ofrezco desarrollo web y
        posicionamiento SEO para empresas y emprendedores en todo el país.
      </p>
      <ul class="flex flex-wrap justify-center gap-2 sm:gap-3 max-w-2xl mx-auto list-none p-0">
        <li class="bg-purple-900/40 text-purple-200 text-base font-medium px-4 py-2 rounded-full border border-purple-700/50 cursor-default transition-all duration-200 hover:bg-purple-700/60 hover:border-purple-400 hover:text-white hover:scale-105">
          Quito
        </li>
        <li class="bg-purple-900/40 text-purple-200 text-base font-medium px-4 py-2 rounded-full border border-purple-700/50 cursor-default transition-all duration-200 hover:bg-purple-700/60 hover:border-purple-400 hover:text-white hover:scale-105">
          Guayaquil
        </li>
        <li class="bg-purple-900/40 text-purple-200 text-base font-medium px-4 py-2 rounded-full border border-purple-700/50 cursor-default transition-all duration-200 hover:bg-purple-700/60 hover:border-purple-400 hover:text-white hover:scale-105">
          Cuenca
        </li>
        <li class="bg-purple-900/40 text-purple-200 text-base font-medium px-4 py-2 rounded-full border border-purple-700/50 cursor-default transition-all duration-200 hover:bg-purple-700/60 hover:border-purple-400 hover:text-white hover:scale-105">
          Ambato
        </li>
        <li class="bg-purple-900/40 text-purple-200 text-base font-medium px-4 py-2 rounded-full border border-purple-700/50 cursor-default transition-all duration-200 hover:bg-purple-700/60 hover:border-purple-400 hover:text-white hover:scale-105">
          Loja
        </li>
        <li class="bg-purple-900/40 text-purple-200 text-base font-medium px-4 py-2 rounded-full border border-purple-700/50 cursor-default transition-all duration-200 hover:bg-purple-700/60 hover:border-purple-400 hover:text-white hover:scale-105">
          Machala
        </li>
        <li class="bg-gray-800 text-gray-400 text-base font-medium px-4 py-2 rounded-full border border-gray-700 cursor-default transition-all duration-200 hover:bg-gray-700 hover:border-gray-500 hover:text-gray-200 hover:scale-105">
          + más ciudades
        </li>
      </ul>
    </div>
  </section>

  <FAQSection />
  <HomeBlogSection />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(localBusinessSchema)}
  />
</Layout>
