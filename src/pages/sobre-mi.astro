---
import Layout from "../layouts/layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---

<Layout
  title="Descubre más Sobre Mí - Sebastian Armijos"
  description="Conoce todas las habilidades de Sebastian Armijos, Desarrollador Web en Cuenca enfocado en la creación de sitios web optimizados."
>
  <Breadcrumb items={[{ name: "Inicio", href: "/" }, { name: "Sobre Mí" }]} />

  <main class="container mx-auto px-6 py-16 md:py-24">
    <!-- flex-col-reverse: en mobile el aside aparece arriba, el contenido abajo -->
    <!-- lg:grid con 3fr/2fr: reparto exacto sin romper el contenedor -->
    <div class="flex flex-col-reverse lg:grid lg:grid-cols-3 gap-10 lg:gap-12">
      <!-- MAIN CONTENT — ocupa 2 de 3 columnas (~66%) en desktop -->
      <div class="min-w-0 lg:col-span-2">
        <!-- Hero -->
        <section class="mb-16">
          <h1
            data-hero-step
            class="text-5xl md:text-6xl font-extrabold text-gray-900 dark:text-gray-100 leading-tight mb-6"
          >
            Hola, soy <span class="text-purple-700 dark:text-purple-400"
              >Sebastián Armijos</span
            >
          </h1>
          <p
            data-hero-step
            class="text-lg md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed mb-6"
          >
            Soy <strong>Desarrollador Web en Cuenca</strong> con experiencia en la
            creación de soluciones digitales modernas y atractivas. Mi enfoque se
            centra en construir <strong>interfaces amigables</strong> que no solo
            luzcan bien, sino que también brinden una <strong
              >experiencia de usuario fácil de usar</strong
            >.
          </p>
          <p
            data-hero-step
            class="text-lg md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed"
          >
            Me encanta transformar ideas en productos web intuitivos y
            eficientes, optimizando cada detalle para el rendimiento y la
            escalabilidad.
          </p>
        </section>

        <!-- Habilidades -->
        <section
          data-animate="up"
          class="bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-gray-800 dark:to-gray-900
                 p-8 md:p-10 rounded-2xl shadow-xl dark:shadow-gray-950/50
                 border border-transparent dark:border-gray-700 mb-16"
        >
          <div class="mb-8">
            <h2
              class="text-3xl font-bold text-gray-800 dark:text-gray-100 mb-1"
            >
              Mis Habilidades
            </h2>
            <p class="text-gray-500 dark:text-gray-400">
              Tecnologías y herramientas que domino
            </p>
          </div>

          <div data-animate-group="up" data-animate-stagger="0.1" class="grid grid-cols-1 gap-5">
            <!-- Backend -->
            <div
              data-animate-item
              class="bg-white dark:bg-gray-800/80 rounded-xl overflow-hidden shadow-md dark:shadow-gray-900/40
                        border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-shadow duration-300"
            >
              <div class="h-1 bg-gradient-to-r from-purple-600 to-indigo-600">
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-5">
                  <div
                    class="w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-xl flex items-center justify-center flex-shrink-0"
                  >
                    <i
                      class="fas fa-server text-purple-700 dark:text-purple-400 text-lg"
                    ></i>
                  </div>
                  <h3
                    class="text-base font-bold text-gray-800 dark:text-gray-100"
                  >
                    Backend & Frameworks
                  </h3>
                </div>
                <ul class="space-y-3">
                  <li class="flex items-center justify-between">
                    <span
                      class="flex items-center gap-2 text-gray-700 dark:text-gray-300 text-sm font-medium"
                    >
                      <i class="fas fa-rocket text-purple-500 text-xs w-3"></i> Astro
                    </span>
                    <span
                      class="text-xs font-semibold px-2.5 py-0.5 bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-400 rounded-full"
                      >Avanzado</span
                    >
                  </li>
                  <li class="flex items-center justify-between">
                    <span
                      class="flex items-center gap-2 text-gray-700 dark:text-gray-300 text-sm font-medium"
                    >
                      <i class="fas fa-code text-red-500 text-xs w-3"></i> Laravel
                      (PHP)
                    </span>
                    <span
                      class="text-xs font-semibold px-2.5 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400 rounded-full"
                      >Avanzado</span
                    >
                  </li>
                  <li class="flex items-center justify-between">
                    <span
                      class="flex items-center gap-2 text-gray-700 dark:text-gray-300 text-sm font-medium"
                    >
                      <i class="fas fa-database text-blue-500 text-xs w-3"></i> MySQL
                      / PostgreSQL
                    </span>
                    <span
                      class="text-xs font-semibold px-2.5 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400 rounded-full"
                      >Avanzado</span
                    >
                  </li>
                </ul>
              </div>
            </div>

            <!-- Frontend -->
            <div
              data-animate-item
              class="bg-white dark:bg-gray-800/80 rounded-xl overflow-hidden shadow-md dark:shadow-gray-900/40
                        border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-shadow duration-300"
            >
              <div class="h-1 bg-gradient-to-r from-indigo-500 to-violet-600">
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-5">
                  <div
                    class="w-10 h-10 bg-indigo-100 dark:bg-indigo-900/30 rounded-xl flex items-center justify-center flex-shrink-0"
                  >
                    <i
                      class="fas fa-paint-brush text-indigo-600 dark:text-indigo-400 text-lg"
                    ></i>
                  </div>
                  <h3
                    class="text-base font-bold text-gray-800 dark:text-gray-100"
                  >
                    Frontend & Estilos
                  </h3>
                </div>
                <ul class="space-y-3">
                  <li class="flex items-center justify-between">
                    <span
                      class="flex items-center gap-2 text-gray-700 dark:text-gray-300 text-sm font-medium"
                    >
                      <i class="fab fa-html5 text-orange-500 text-xs w-3"></i> HTML5
                      & CSS3
                    </span>
                    <span
                      class="text-xs font-semibold px-2.5 py-0.5 bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-400 rounded-full"
                      >Experto</span
                    >
                  </li>
                  <li class="flex items-center justify-between">
                    <span
                      class="flex items-center gap-2 text-gray-700 dark:text-gray-300 text-sm font-medium"
                    >
                      <i class="fas fa-layer-group text-cyan-500 text-xs w-3"
                      ></i> Tailwind CSS
                    </span>
                    <span
                      class="text-xs font-semibold px-2.5 py-0.5 bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-400 rounded-full"
                      >Experto</span
                    >
                  </li>
                  <li class="flex items-center justify-between">
                    <span
                      class="flex items-center gap-2 text-gray-700 dark:text-gray-300 text-sm font-medium"
                    >
                      <i class="fab fa-js text-yellow-500 text-xs w-3"></i> JavaScript
                      (ES6+)
                    </span>
                    <span
                      class="text-xs font-semibold px-2.5 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400 rounded-full"
                      >Avanzado</span
                    >
                  </li>
                </ul>
              </div>
            </div>

            <!-- Tools -->
            <div
              data-animate-item
              class="bg-white dark:bg-gray-800/80 rounded-xl overflow-hidden shadow-md dark:shadow-gray-900/40
                        border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-shadow duration-300"
            >
              <div class="h-1 bg-gradient-to-r from-violet-500 to-purple-700">
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-5">
                  <div
                    class="w-10 h-10 bg-violet-100 dark:bg-violet-900/30 rounded-xl flex items-center justify-center flex-shrink-0"
                  >
                    <i
                      class="fas fa-tools text-violet-600 dark:text-violet-400 text-lg"
                    ></i>
                  </div>
                  <h3
                    class="text-base font-bold text-gray-800 dark:text-gray-100"
                  >
                    Optimización & Herramientas
                  </h3>
                </div>
                <ul class="space-y-3">
                  <li class="flex items-center justify-between">
                    <span
                      class="flex items-center gap-2 text-gray-700 dark:text-gray-300 text-sm font-medium"
                    >
                      <i class="fas fa-search text-green-500 text-xs w-3"></i> SEO
                      Técnico
                    </span>
                    <span
                      class="text-xs font-semibold px-2.5 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400 rounded-full"
                      >Avanzado</span
                    >
                  </li>
                  <li class="flex items-center justify-between">
                    <span
                      class="flex items-center gap-2 text-gray-700 dark:text-gray-300 text-sm font-medium"
                    >
                      <i class="fab fa-git-alt text-orange-600 text-xs w-3"></i> Git
                      & GitHub
                    </span>
                    <span
                      class="text-xs font-semibold px-2.5 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400 rounded-full"
                      >Avanzado</span
                    >
                  </li>
                  <li class="flex items-center justify-between">
                    <span
                      class="flex items-center gap-2 text-gray-700 dark:text-gray-300 text-sm font-medium"
                    >
                      <i class="fas fa-terminal text-blue-400 text-xs w-3"></i> VS
                      Code
                    </span>
                    <span
                      class="text-xs font-semibold px-2.5 py-0.5 bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-400 rounded-full"
                      >Experto</span
                    >
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- CTA -->
        <section
          data-animate="up"
          class="relative overflow-hidden bg-gradient-to-br from-purple-700 to-indigo-800
                        dark:from-purple-900 dark:to-indigo-950 p-8 md:p-12 rounded-2xl shadow-2xl text-white"
        >
          <!-- Decorative blobs -->
          <div
            class="absolute -top-12 -right-12 w-48 h-48 bg-white/5 rounded-full pointer-events-none"
          >
          </div>
          <div
            class="absolute -bottom-10 -left-10 w-36 h-36 bg-white/5 rounded-full pointer-events-none"
          >
          </div>

          <!-- Stats -->
          <div
            class="relative flex flex-wrap gap-6 sm:gap-10 justify-center mb-8 pb-8 border-b border-white/20"
          >
            <div class="text-center">
              <p class="text-4xl font-extrabold stat-counter" data-count="3">
                0+
              </p>
              <p class="text-sm text-purple-200 mt-1">Años de experiencia</p>
            </div>
            <div class="text-center">
              <p class="text-4xl font-extrabold stat-counter" data-count="10">
                0+
              </p>
              <p class="text-sm text-purple-200 mt-1">Proyectos completados</p>
            </div>
            <div class="text-center">
              <p class="text-4xl font-extrabold stat-counter" data-count="10">
                0+
              </p>
              <p class="text-sm text-purple-200 mt-1">Clientes satisfechos</p>
            </div>
          </div>

          <!-- Copy + Buttons -->
          <div class="relative text-center">
            <h2 class="text-3xl md:text-4xl font-extrabold mb-4">
              ¿Interesado en Trabajar Juntos?
            </h2>
            <p
              class="text-base md:text-lg text-purple-100 mb-8 max-w-xl mx-auto"
            >
              Si buscas un <strong class="text-white"
                >Desarrollador de Software en Cuenca</strong
              > dedicado, con experiencia real y enfoque en resultados, estoy listo
              para tu proyecto.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href="/contacto"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-purple-700
                       text-base font-bold rounded-xl shadow-lg hover:bg-purple-50
                       transform transition-all duration-300 hover:scale-105"
              >
                <i class="fas fa-paper-plane"></i>
                Contáctame
              </a>
              <a
                href="/servicios"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-transparent
                       border-2 border-white/60 text-white text-base font-bold rounded-xl
                       hover:bg-white/10 transform transition-all duration-300 hover:scale-105"
              >
                <i class="fas fa-briefcase"></i>
                Ver Servicios
              </a>
            </div>
          </div>
        </section>
      </div>

      <!-- ASIDE STICKY — columna derecha en desktop, arriba en mobile -->
      <aside>
        <div data-animate="right" class="sticky top-24 flex flex-col items-center text-center">
          <!-- Foto circular -->
          <img
            src="/assets/foto-de-perfil-actualizada.webp"
            alt="Foto de Sebastián Armijos"
            title="Foto de Sebastian Armijos"
            class="rounded-full shadow-2xl object-cover w-72 h-72 sm:w-80 sm:h-80 lg:w-96 lg:h-96 xl:w-96 xl:h-96
                   border-4 border-purple-300 dark:border-purple-700
                   transform transition-transform duration-300 hover:scale-105"
            loading="lazy"
          />

          <!-- Nombre y rol -->
          <h2 class="mt-6 text-xl font-bold text-gray-900 dark:text-gray-100">
            Sebastián Armijos
          </h2>
          <p
            class="text-purple-700 dark:text-purple-400 font-medium text-sm mt-1"
          >
            Desarrollador Web Full Stack
          </p>
          <span
            class="inline-flex items-center gap-1.5 mt-3 px-3 py-1.5 bg-green-100 dark:bg-green-900/30
                       text-green-700 dark:text-green-400 text-xs font-semibold rounded-full"
          >
            <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"
            ></span>
            Disponible para proyectos
          </span>

          <!-- Redes sociales (iconos en fila) -->
          <div class="flex items-center justify-center flex-wrap gap-3 mt-6">
            <a
              href="https://www.linkedin.com/in/sebastian-armijos-467b171b2/"
              target="_blank"
              rel="noopener noreferrer"
              title="LinkedIn"
              class="w-11 h-11 bg-blue-600 rounded-full flex items-center justify-center
                     text-white hover:bg-blue-700
                     transform transition-all duration-200 hover:scale-110 shadow-md"
            >
              <i class="fab fa-linkedin-in text-base"></i>
            </a>

            <a
              href="https://github.com/sebastian8080"
              target="_blank"
              rel="noopener noreferrer"
              title="GitHub"
              class="w-11 h-11 bg-gray-900 dark:bg-gray-700 rounded-full flex items-center justify-center
                     text-white hover:bg-purple-700 dark:hover:bg-purple-600
                     transform transition-all duration-200 hover:scale-110 shadow-md"
            >
              <i class="fab fa-github text-base"></i>
            </a>

            <a
              href="https://api.whatsapp.com/send?phone=593964085651&text=Hola%20Sebastian,%20te%20escribo%20porque%20estoy%20interesado%20en%20uno%20de%20tus%20servicios"
              target="_blank"
              rel="noopener noreferrer"
              title="WhatsApp"
              class="w-11 h-11 bg-green-500 rounded-full flex items-center justify-center
                     text-white hover:bg-green-600
                     transform transition-all duration-200 hover:scale-110 shadow-md"
            >
              <i class="fab fa-whatsapp text-base"></i>
            </a>

            <a
              href="https://www.instagram.com/sebastian.armijos/"
              target="_blank"
              rel="noopener noreferrer"
              title="Instagram"
              style="background-color: #C13584;"
              class="w-11 h-11 rounded-full flex items-center justify-center
                     text-white transform transition-all duration-200 hover:scale-110 shadow-md"
            >
              <i class="fab fa-instagram text-base"></i>
            </a>

            <a
              href="https://www.facebook.com/sebastian.armijos.56/"
              target="_blank"
              rel="noopener noreferrer"
              title="Facebook"
              class="w-11 h-11 bg-blue-700 rounded-full flex items-center justify-center
                     text-white hover:bg-blue-800
                     transform transition-all duration-200 hover:scale-110 shadow-md"
            >
              <i class="fab fa-facebook-f text-base"></i>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </main>
  <script>
    const counters = document.querySelectorAll<HTMLElement>(".stat-counter");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.count ?? "0", 10);
          const duration = 1400;
          const startTime = performance.now();

          const tick = (now: number) => {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.floor(eased * target) + "+";
            if (progress < 1) requestAnimationFrame(tick);
          };

          requestAnimationFrame(tick);
          observer.unobserve(el);
        });
      },
      { threshold: 0.6 },
    );

    counters.forEach((el) => observer.observe(el));
  </script>
</Layout>
