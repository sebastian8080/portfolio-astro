---
import { getCollection } from "astro:content";
import Layout from "../layouts/layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("es-ES", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);

const links = [
  { href: "/servicios", label: "Ver servicios" },
  { href: "/blog", label: "Ir al blog" },
  { href: "/contacto", label: "Contacto" },
];
---

<Layout
  title="¡Gracias por tu mensaje! | Sebastián Armijos"
  description="Hemos recibido tu mensaje. Nos pondremos en contacto contigo muy pronto."
>
  <Breadcrumb items={[{ name: "Inicio", href: "/" }, { name: "Gracias" }]} />

  <!-- Hero de confirmación -->
  <section class="bg-gradient-to-br from-purple-600 to-indigo-700 text-white py-20 md:py-28">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <div class="flex justify-center mb-6">
        <div class="bg-white/20 rounded-full p-5">
          <svg class="w-14 h-14 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-4 leading-tight">
        ¡Mensaje recibido!
      </h1>
      <p class="text-lg md:text-xl text-purple-100 max-w-2xl mx-auto leading-relaxed">
        Gracias por ponerte en contacto. Revisaré tu mensaje y me pondré en contacto contigo
        <strong class="text-white">en menos de 48 horas</strong>.
      </p>
    </div>
  </section>

  <!-- Sección de navegación -->
  <section class="py-16 md:py-20 bg-white dark:bg-gray-950 transition-colors duration-300">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        Mientras tanto, ¿qué quieres explorar?
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-10 max-w-xl mx-auto">
        Sigue navegando por el sitio y descubre todo lo que puedo ofrecerte.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        {links.map(({ href, label }) => (
          <a
            href={href}
            class="inline-block bg-purple-600 hover:bg-purple-700 text-white font-semibold px-8 py-3 rounded-lg shadow-md transition duration-300 transform hover:scale-105"
          >
            {label}
          </a>
        ))}
        <a
          href="/"
          class="inline-block bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-100 font-semibold px-8 py-3 rounded-lg shadow-md hover:bg-gray-50 dark:hover:bg-gray-700 transition duration-300 transform hover:scale-105"
        >
          Inicio
        </a>
      </div>
    </div>
  </section>

  <!-- Últimos artículos del blog -->
  {latestPosts.length > 0 && (
    <section class="py-16 md:py-20 bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-gray-100 mb-4">
            Mientras esperas, lee algo útil
          </h2>
          <p class="text-gray-600 dark:text-gray-400 max-w-xl mx-auto">
            Artículos sobre desarrollo web, SEO y tecnología para que tu negocio crezca online.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestPosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/50 overflow-hidden border border-transparent dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col"
            >
              {post.data.image && (
                <div class="overflow-hidden h-48">
                  <img
                    src={post.data.image.url}
                    alt={post.data.image.alt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
              )}
              <div class="p-6 flex flex-col flex-1">
                <div class="flex flex-wrap gap-2 mb-3">
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-400 text-xs font-medium px-2 py-1 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors leading-snug">
                  {post.data.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed flex-1 line-clamp-3">
                  {post.data.description}
                </p>
                <time class="mt-4 text-xs text-gray-400 dark:text-gray-500">
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
            </a>
          ))}
        </div>

        <div class="text-center mt-12">
          <a
            href="/blog"
            class="inline-block border-2 border-purple-600 text-purple-600 dark:text-purple-400 dark:border-purple-400 font-semibold px-8 py-3 rounded-lg hover:bg-purple-600 hover:text-white dark:hover:bg-purple-400 dark:hover:text-gray-900 transition-all duration-300"
          >
            Ver todos los artículos
          </a>
        </div>
      </div>
    </section>
  )}
</Layout>
